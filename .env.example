# =====================================================================
# VayuNetra — environment template.  Copy to `.env` and fill in.
# NEVER commit the real .env (it's git-ignored).  ₹0 / free-tier only.
# =====================================================================

# --- Runtime flags -----------------------------------------------------
DEMO_MODE=true                 # true = run entirely on demo/fixtures (offline, demo-proof)
ENV=dev                        # dev | preview | prod
LOG_LEVEL=info

# --- LLM (model-agnostic; swap provider with one var) ------------------
LLM_PROVIDER=gemini            # gemini | groq | ollama
GEMINI_API_KEY=                # https://aistudio.google.com/apikey  (free tier)
GROQ_API_KEY=                  # fallback (free Llama 3.3)
OLLAMA_BASE_URL=http://localhost:11434   # local fallback

# --- Embeddings (RAG) --------------------------------------------------
EMBEDDINGS_PROVIDER=local      # local (bge-small, zero-API) | gemini
# NOTE: bge-small-en-v1.5 = 384 dims; Gemini text-embedding = 768 dims.
#       The DB vector() column dim MUST match — see infra/supabase/migrations/0001_init.sql.
EMBEDDING_DIM=384

# --- Supabase (Postgres + PostGIS + pgvector + Auth) -------------------
SUPABASE_URL=                  # https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only — never ship to the browser
SUPABASE_DB_URL=               # postgresql://...:5432/postgres  (for migrations)

# --- Google Earth Engine (satellite) -----------------------------------
GEE_SERVICE_ACCOUNT=           # xxx@project.iam.gserviceaccount.com
GEE_KEY_JSON=./gee-key.json    # path to service-account key (git-ignored)
GEE_PROJECT=                   # registered EE Cloud project id (e.g. vayunetra-500711)

# --- Ground AQI feeds --------------------------------------------------
DATA_GOV_IN_API_KEY=           # CPCB CAAQMS via data.gov.in
OPENAQ_API_KEY=                # fallback / backfill (optional)
# Open-Meteo weather + AQ needs NO key.

# --- Citizen channels --------------------------------------------------
TELEGRAM_BOT_TOKEN=            # @BotFather (free)
TWILIO_ACCOUNT_SID=            # IVR demo (trial credit)
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # inbound: set this number's Voice webhook to <api>/ivr/inbound
TWILIO_TO_NUMBERS=             # outbound broadcast recipients, comma-separated (trial: verified only)

# --- Maps --------------------------------------------------------------
MAPTILER_KEY=                  # optional free basemap key (or self-host Protomaps PMTiles)
TOMTOM_API_KEY=                # optional: live traffic congestion (free tier) — blends into the mobility proxy

# --- Deploy ------------------------------------------------------------
GCP_PROJECT=                   # Cloud Run (FastAPI)
# Vercel reads its own env from the dashboard.

# --- Frontend (Vite — only VITE_* vars reach the browser) --------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=true

# Public URLs used in the officer morning brief (notice links, console link)
PUBLIC_API_BASE_URL=            # e.g. https://vayunetra-api.onrender.com
PUBLIC_WEB_URL=                 # e.g. https://vayunetra-aqi.vercel.app/console
